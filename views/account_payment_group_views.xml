<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <!--
            Lupatini — agrega total al pie de la columna "Monto" (balance)
            en la pestaña Deudas del recibo.

            Por qué balance y no amount_residual:
            - balance es store=True monetary, el sum funciona a nivel SQL.
            - amount_residual está reemplazado por el OCA por un campo
              computed con store=False (payment_group_matched_amount),
              y los sum sobre non-stored no se renderizan (por eso los
              pies hoy aparecen como "—").
            - balance refleja el importe original; para facturas sin pagos
              parciales coincide con el saldo pendiente.
        -->

        <record id="view_move_line_tree_lupatini_sum" model="ir.ui.view">
            <field name="name">account.move.line.tree.lupatini.sumatoria</field>
            <field name="model">account.move.line</field>
            <field name="inherit_id" ref="account_payment_group.view_move_line_tree"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='balance']" position="attributes">
                    <attribute name="sum">Total</attribute>
                </xpath>
            </field>
        </record>

        <!--
            Campo "Total deuda del cliente" al pie de la pestaña Deudas,
            con estilo subtotal a la derecha (como el subtotal de facturas).
            Suma amount_residual de debt_move_line_ids (saldo pendiente).
            Como debt_move_line_ids es many2many computed store=False, el
            footer sum del listado no funciona — este campo lo reemplaza.
        -->
        <record id="view_account_payment_group_form_lupatini_debt_total" model="ir.ui.view">
            <field name="name">account.payment.group.form.lupatini.debt_total</field>
            <field name="model">account.payment.group</field>
            <field name="inherit_id" ref="account_payment_group.view_account_payment_group_form"/>
            <field name="arch" type="xml">
                <field name="debt_move_line_ids" position="after">
                    <group class="oe_subtotal_footer oe_right">
                        <field name="debt_total_amount"
                               options="{'currency_field': 'currency_id'}"/>
                    </group>
                </field>
            </field>
        </record>

    </data>
</odoo>
